{
  "namespace": "start",

  "resource_pack_information": {
    "type": "panel",
    "anchor_from": "top_center",
    "anchor_to": "top_center",
    "controls": [
      {
        "label": {
          "type": "label",
          "color": "$main_header_text_color",
          "layer": 2,
          "text": "§7creative subpacks are enabled",
          "size": [ "default", 10 ],
          "max_size": [ "100%", "100%" ]
        }
      },
      {
        "label_background": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": 0.6,
          "size": [ "100%sm + 4px", "100%sm + 2px" ],
          "layer": 1
        }
      }
    ]
  },

  "text_panel": {
    "type": "panel",
    "size": [ "100%-2px", 10 ],
    "offset": [ 0, -1 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      {"copyright@start.copyright": {}},
      {"development_version@start.development_version": {"ignored": "$is_publish"}},
      {"version@start.version": {}},
      {"resource_pack_information@start.resource_pack_information": {}}
    ]
  },
  "b_a": {"anim_type": "wait","duration": 2.0,"next": "@b_a2"},
  "b_a2": {"anim_type": "alpha","easing": "linear","duration": 2.0,"from": 1.0,"to": 0.0},
  "start_screen_content": {
      "modifications": [{
          "array_name": "controls",
          "operation": "insert_front",
          "value": [{
              "black": {
                  "type": "image",
                  "size": ["99999%","99999%"],
                  "texture": "textures/ui/Black",
                  "layer": 99999,
                  "anims": ["@start.b_a"]
              }
          }]
      }]
  }
}