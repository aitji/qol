{
	"namespace": "common",
	"selected_item_details_factory": {
		"ignored": true
	},
	"back_title_button_content/chevron_panel/left_chevron": {
		"color": "$light_button_default_text_color"
	},
	"highlight_slot_panel/highlight": {
		"bindings": [],
		"modifications": [
			{
				"control_name": "hover_text",
				"operation": "remove"
			},
			{
				"array_name": "controls",
				"operation": "insert_front",
				"value": {
					"hover_text_new@common_ds-dtv.hover_text": {}
				}
			}
		]
	},
	"container_item/item_cell/item": {
    "$renderer_binding_name|default": "#hover_text",
    "$renderer_binding_type|default": "collection",
    "$renderer_binding_collection_name|default": "$item_collection_name",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "suspicious_stew_effect_icon@effect_icon_ds-ssi.suspicious_stew_effect_icon": {
            "size": [ 9, 9 ],
            "anchor_from": "top_right",
            "anchor_to": "top_right",
            "offset": [ -1, 1 ],
            "layer": 8
          }
        }
      }
    ],
    "controls": [
      {
        "stack_count_label@common.stack_count_label": { "layer": 27 }
      },
      {
        "normal_item_renderer": {
          "type": "panel",
          "controls": [
            {
              "item_renderer@$item_renderer": {
                "size": "$item_renderer_size",
                "anchor_to": "center",
                "anchor_from": "center",
                "offset": "$item_renderer_offset",
                "layer": 7
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "$renderer_binding_name",
              "binding_name_override": "#item_name",
              "binding_type": "$renderer_binding_type",
              "binding_collection_name": "$renderer_binding_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#item_name - '§d§i§m§z§e§b§r§f') = #item_name) = 0)",
              "target_property_name": "#is_enchanted_book"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#item_name - '§e§i§d') = #item_name) = 0)",
              "target_property_name": "#has_properties"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#is_enchanted_book * #has_properties) = 0)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "enchanted_book_renderer": {
          "type": "panel",
          "controls": [
            {
              "item_renderer@item_renderer_ds-beb.enchanted_book_renderer": {
                "size": "$item_renderer_size",
                "anchor_to": "center",
                "anchor_from": "center",
                "offset": "$item_renderer_offset",
                "layer": 7
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "normal_item_renderer",
              "source_property_name": "(not #visible)",
              "target_property_name": "#visible",
              "resolve_sibling_scope": true
            }
          ]
        }
      }
    ]
  },
  "highlight_slot_panel/highlight/hover_text": {
    "property_bag": {
      "#suspicious_stew_10": "\n§r§f§7night vision (0:04)",
      "#suspicious_stew_11": "\n§r§f§7jump boost (0:04)",
      "#suspicious_stew_12": "\n§r§f§cweakness (0:07)",
      "#suspicious_stew_13": "\n§r§f§cblindness (0:06)",
      "#suspicious_stew_14": "\n§r§f§cpoison (0:10)",
      "#suspicious_stew_16": "\n§r§f§7saturation (0:03)",
      "#suspicious_stew_17": "\n§r§f§7fire resistance (0:02)",
      "#suspicious_stew_18": "\n§r§f§7regeneration (0:06)",
      "#suspicious_stew_19": "\n§r§f§cwither (0:06)"
    },
    "bindings": [
      {
        "binding_type": "collection_details"
      },
      {
        "binding_name": "$hover_text_binding_name",
        "binding_name_override": "#hover_text_binding",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux / 65536)",
        "target_property_name": "#item_id",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux - (#item_id * 65536))",
        "target_property_name": "#child_item_id",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "('suspicious_stew_' + ((#item_id = $suspicious_stew_id) * 1) + #child_item_id)",
        "target_property_name": "#suspicious_item_id",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hover_text_binding + ('#' + #suspicious_item_id))",
        "target_property_name": "#hover_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_id_aux = -1))",
        "target_property_name": "#visible"
      }
    ]
  },
  "container_item": {
    "$use_container_item_mode|default": false,
    "$use_item_highlighter|default": false,
    "modifications": [
      {
        "control_name": "item_button_ref",
        "operation": "remove"
      },
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "container_item_button_ref@container_item_ds-acr.item_button_ref_switcher": {}
          },
          {
            "container_item_highlighter@container_item_ds-acr.container_item_highlighter": {}
          }
        ]
      }
    ]
  }
}