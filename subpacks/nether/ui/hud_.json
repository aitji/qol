{
    "namespace": "hud_ds-cvr",
    
    "pocket_padding": {
      "type": "panel",
      "size": [ "100%", 32 ],
      "bindings": [
        { "binding_name": "#hud_visible_not_centered" },
        { "binding_name": "#show_survival_ui" },
        {
          "binding_type": "view",
          "source_property_name": "(#hud_visible_not_centered and #show_survival_ui)",
          "target_property_name": "#visible"
        }
      ]
    },
    
    
    "chunk_label_panel": {
      "type": "image",
      "texture": "$dimz_cvr_chunk_info_background_texture",
      "size": "$dimz_cvr_chunk_label_background_size",
      "anchor_from": "$dmz_clp_anchor_from",
      "anchor_to": "$dmz_clp_anchor_to",
      "offset": "$dmz_clp_offset",
      "color": "$dimz_cvr_chunk_info_background_color",
      "alpha": "$dimz_cvr_chunk_info_background_alpha",
      "variables": [
        {
          "requires": "(not $dimz_cvr_reverse)",
          "$dmz_clp_anchor_from": "bottom_right",
          "$dmz_clp_anchor_to": "bottom_left",
          "$dmz_clp_offset": [ 0, -2 ]
        },
        {
          "requires": "$dimz_cvr_reverse",
          "$dmz_clp_anchor_from": "bottom_left",
          "$dmz_clp_anchor_to": "bottom_right",
          "$dmz_clp_offset": [ 0, -2 ]
        }
      ],
      "controls": [
        {
          "none": {
            "type": "label",
            "text": "dimzChunkViewer.chunkPanel.none",
            "layer": 1,
            "shadow": true,
            "bindings": [
              {
                "binding_type": "view",
                "source_control_name": "chunk_middle",
                "source_property_name": "(not #visible)",
                "target_property_name": "#is_chunk_middle"
              },
              {
                "binding_type": "view",
                "source_control_name": "chunk_edge",
                "source_property_name": "(not #visible)",
                "target_property_name": "#is_chunk_edge"
              },
              {
                "binding_type": "view",
                "source_control_name": "chunk_corner",
                "source_property_name": "(not #visible)",
                "target_property_name": "#is_chunk_corner"
              },
              {
                "binding_type": "view",
                "source_property_name": "(#is_chunk_middle and #is_chunk_edge and #is_chunk_corner)",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "chunk_middle": {
            "type": "label",
            "text": "dimzChunkViewer.chunkPanel.chunkMiddle",
            "layer": 1,
            "shadow": true,
            "bindings": [
              {
                "binding_type": "view",
                "source_control_name": "player_position_data",
                "source_property_name": "(((#in_chunk_x = 7) or (#in_chunk_x = 8)) and ((#in_chunk_z = 7) or (#in_chunk_z = 8)))",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "chunk_edge": {
            "type": "label",
            "text": "dimzChunkViewer.chunkPanel.chunkEdge",
            "layer": 1,
            "shadow": true,
            "bindings": [
              {
                "binding_type": "view",
                "source_control_name": "player_position_data",
                "source_property_name": "(((#in_chunk_x > 0) and (#in_chunk_x < 15)) and ((#in_chunk_z > 0) and (#in_chunk_z < 15)))",
                "target_property_name": "#is_edge"
              },
              {
                "binding_type": "view",
                "source_control_name": "chunk_corner",
                "source_property_name": "(not #visible)",
                "target_property_name": "#is_not_corner"
              },
              {
                "binding_type": "view",
                "source_property_name": "(not #is_edge and #is_not_corner)",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "chunk_corner": {
            "type": "label",
            "text": "dimzChunkViewer.chunkPanel.chunkCorner",
            "layer": 1,
            "shadow": true,
            "bindings": [
              {
                "binding_type": "view",
                "source_control_name": "player_position_data",
                "source_property_name": "(((#in_chunk_x = 0) or (#in_chunk_x = 15)) and ((#in_chunk_z = 0) or (#in_chunk_z = 15)))",
                "target_property_name": "#visible"
              }
            ]
          }
        }
      ]
    },
    
    "chunk_position_panel": {
      "type": "image",
      "texture": "$dimz_cvr_chunk_info_background_texture",
      "size": "$dimz_cvr_chunk_position_background_size",
      "anchor_from": "$dmz_cpp_anchor_from",
      "anchor_to": "$dmz_cpp_anchor_to",
      "offset": "$dmz_cpp_offset",
      "color": "$dimz_cvr_chunk_info_background_color",
      "alpha": "$dimz_cvr_chunk_info_background_alpha",
      "variables": [
        {
          "requires": "(not $dimz_cvr_reverse)",
          "$dmz_cpp_anchor_from": "top_right",
          "$dmz_cpp_anchor_to": "top_left",
          "$dmz_cpp_offset": [ 0, 2 ]
        },
        {
          "requires": "$dimz_cvr_reverse",
          "$dmz_cpp_anchor_from": "top_left",
          "$dmz_cpp_anchor_to": "top_right",
          "$dmz_cpp_offset": [ 0, 2 ]
        }
      ],
      "controls": [
        {
          "text": {
            "type": "label",
            "text": "#text",
            "layer": 1,
            "shadow": true,
            "bindings": [
              {
                "binding_type": "view",
                "source_control_name": "player_position_data",
                "source_property_name": "('§z§lChunk§r\n§c| §rX§c:§r ' + #chunk_x + ' (' + #in_chunk_x + ')\n§c| §rY§c:§r ' + #chunk_y + ' (' + #in_chunk_y + ')\n§c| §rZ§c:§r ' + #chunk_z + ' (' + #in_chunk_z + ')')",
                "target_property_name": "#text"
              }
            ]
          }
        },
        {
          "paperdoll_holder": {
            "ignored": "(not (($dimz_cvr_anchor_from = 'top_left') and ($dimz_cvr_anchor_to = 'top_left')))",
            "type": "panel",
            "size": [ 0, 0 ],
            "anchor_from": "right_middle",
            "anchor_to": "left_middle",
            "controls": [
              {
                "paperdoll@hud.hud_player_renderer": {
                  "anchor_from": "left_middle",
                  "anchor_to": "left_middle",
                  "offset": [ 15, -5 ]
                }
              }
            ]
          }
        }
      ]
    },
    
    "direction_label": {
      "type": "label",
      "text_alignment": "center",
      "font_scale_factor": 0.963,
      "font_type": "default",
      "shadow": true
    },
    
    "direction_text_panel": {
      "type": "panel",
      "size": [ "100%", "100%" ],
      "controls": [
        {
          "east@hud_ds-cvr.direction_label": {
            "text": "E",
            "anchor_from": "right_middle",
            "anchor_to": "right_middle",
            "offset": [ -0.5, 0 ]
          }
        },
        {
          "south@hud_ds-cvr.direction_label": {
            "text": "S",
            "anchor_from": "bottom_middle",
            "anchor_to": "bottom_middle",
            "offset": [ 0, -0.5 ]
          }
        },
        {
          "west@hud_ds-cvr.direction_label": {
            "text": "W",
            "anchor_from": "left_middle",
            "anchor_to": "left_middle",
            "offset": [ 1.5, 0 ]
          }
        },
        {
          "north@hud_ds-cvr.direction_label": {
            "text": "N",
            "anchor_from": "top_middle",
            "anchor_to": "top_middle",
            "offset": [ 0, 0 ]
          }
        }
      ]
    },
    
    
    "slime_chunk_image": {
      "type": "image",
      "texture": "('textures/ui/chunk_viewer/slime/dimz_slime_' + $slime_id)",
      "size": "$slime_chunk_scale_size",
