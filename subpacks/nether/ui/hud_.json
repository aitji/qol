    "anchored_slime_chunk": {
      "type": "image",
      "size": [ "100%", "100%" ],
      "use_anchored_offset": true,
      "property_bag": { // guess why not use the same method☕
        "#size_binding_x": 20.0,
        "#size_binding_y": 20.0
      },
      "bindings": [
        {
          "binding_type": "view",
          "source_control_name": "player_position_data",
          "source_property_name": "#reverse_chunk_x",
          "target_property_name": "#size_binding_x"
        },
        {
          "binding_type": "view",
          "source_control_name": "player_position_data",
          "source_property_name": "#reverse_chunk_z",
          "target_property_name": "#size_binding_y"
        }
      ],
      "controls": [
        {
          "slime_chunk_image@hud_ds-cvr.slime_chunk_panel": {}
        }
      ]
    },
    
    
    "chunk_border_image": {
      "type": "image",
      "texture": "textures/ui/chunk_viewer/chunk_border",
      "size": "$chunk_border_scale_size",
      "anchor_from": "top_left",
      "anchor_to": "center",
      "color": [ 0.85, 0.85, 0.85 ],
      "controls": [
        {
          "slime_chunk_control": {
            "type": "panel",
            "size": "$slime_chunk_step_scale",
            "layer": -1,
            "controls": [
              {
                "slime_chunk@hud_ds-cvr.anchored_slime_chunk": {
                  "anchor_from": "top_left",
                  "anchor_to": "top_left"
                }
              }
            ]
          }
        }
      ]
    },
    
    "anchored_chunk_border": {
      "type": "panel",
      "size": [ "100%cm", "100%cm" ],
      "use_anchored_offset": true,
      "property_bag": {
        "#anchored_offset_value_x": 1.25,
        "#anchored_offset_value_y": 1.25
      },
      "bindings": [
        {
          "binding_type": "view",
          "source_control_name": "player_position_data",
          "source_property_name": "#reverse_in_chunk_x",
          "target_property_name": "#anchored_offset_value_x"
        },
        {
          "binding_type": "view",
          "source_control_name": "player_position_data",
          "source_property_name": "#reverse_in_chunk_z",
          "target_property_name": "#anchored_offset_value_y"
        }
      ],
      "controls": [
        {
          "chunk_border_image@hud_ds-cvr.chunk_border_image": {
            "offset": "$chunk_border_scale_offset"
          }
        }
      ]
    },
    
    
    "expanded_chunk_position_panel": {
      "type": "panel",
      "size": [ "100%c", "100%c" ],
      "anchor_from": "bottom_middle",
      "anchor_to": "top_middle",
      "controls": [
        {
          "text": {
            "type": "label",
            "text": "#text",
            "size": [ "default", "default" ],
            "shadow": true,
            "bindings": [
              {
                "binding_type": "view",
                "source_control_name": "player_position_data",
                "source_property_name": "(#chunk_x * 16)",
                "target_property_name": "#from_chunk_x"
              },
              {
                "binding_type": "view",
                "source_control_name": "player_position_data",
                "source_property_name": "(#chunk_z * 16)",
                "target_property_name": "#from_chunk_z"
              },
              {
                "binding_type": "view",
                "source_property_name": "(#from_chunk_x + 15)",
                "target_property_name": "#to_chunk_x"
              },
              {
                "binding_type": "view",
                "source_property_name": "(#from_chunk_z + 15)",
                "target_property_name": "#to_chunk_z"
              },
              {
                "binding_type": "view",
                "source_property_name": "('§z' + #from_chunk_x + ', ' + #from_chunk_z + ' -> ' + #to_chunk_x + ', ' + #to_chunk_z)",
                "target_property_name": "#text"
              }
            ]
          }
        }
      ]
    },
    
    "expanded_chunk_viewer_panel": {
      "type": "panel",
      "size": [ 200, 150 ],
      
      "$chunk_border_step_scale": [ 1, 1 ],
      "$chunk_border_scale_size": [ 208, 208 ],
      "$chunk_border_scale_offset": [ 8, 8 ],
      "$slime_chunk_step_scale": [ 16, 16 ],
      "$slime_chunk_scale_size": [ 6144, 6144 ],
      
      "controls": [
        {
          "background": {
            "type": "image",
            "texture": "textures/ui/chunk_viewer/chunk_background",
            "size": [ 198, 148],
            "anchor_from": "center",
            "anchor_to": "center",
            "layer": 1
          }
        },
        {
          "content": {
            "type": "panel",
            "size": [ "100% - 12px", "100% - 12px" ],
            "anchor_from": "center",
            "anchor_to": "center",
            "layer": 2,
            "controls": [
              {
                "inner_background": {
                  "type": "image",
                  "texture": "textures/ui/chunk_viewer/chunk_inner_background",
                  "layer": 5
                }
              },
              {
                "chunk_viewer@hud_ds-cvr.chunk_viewer": {
                  "layer": 1
                }
              }
            ]
          }
        },
        {
          "expanded_chunk_position_panel@hud_ds-cvr.expanded_chunk_position_panel": {
            "ignored": "(not $dimz_cvr_show_chunk_info)"
          }
        }
      ]
    },
    
    "expanded_chunk_viewer_control_panel": {
      "type": "collection_panel",
      "size": [ "100%cm", "100%cm" ],
      "offset": [ 0, "10%" ],
      "anchor_from": "top_middle",
      "anchor_to": "top_middle",
      "collection_name": "expanded_chunk_viewer_panels",
      "factory": {
        "name": "expanded_chunk_viewer_panel_factory",
        "control_name": "@hud_ds-cvr.expanded_chunk_viewer_panel",
        "max_children_size": 1
      },
      "bindings": [
        {
          "binding_name": "#player_position_visible",
          "binding_condition": "always"
        },
        {
          "binding_type": "view",
          "source_control_name": "expand_button_toggle",
          "source_property_name": "#toggle_state",
          "target_property_name": "#button"
        },
        {
          "binding_type": "view",
          "source_property_name": "((#button and #player_position_visible) * 1)",
          "target_property_name": "#collection_length"
        }
      ]
    },
    
    "map_expand_button@common_toggles.light_text_toggle": {
      "$toggle_name": "map_expand_buttons",
      "$toggle_view_binding_name": "expand_button_toggle",
      "$button_text": "",
      
      "$toggle_focus_enabled": false
    },
    
    
    "chunk_viewer": {
      "type": "panel",
      "size": [ "100% - 2px", "100% - 2px" ],
      
      "$chunk_border_step_scale|default": "$dimz_cvr_chunk_border_step_scale",
      "$chunk_border_scale_size|default": [ 260, 260 ],
      "$chunk_border_scale_offset|default": [ 10, 10 ],
      "$slime_chunk_step_scale|default": "$dimz_cvr_slime_chunk_step_scale",
      "$slime_chunk_scale_size|default": [ 7680, 7680 ],
      "$slime_chunk_scale_offset|default": [ 0, 0 ],
      
      "clips_children": true,
      "controls": [
        {
          "player_icon": {
            "type": "image",
            "texture": "textures/ui/Ping_Offline_Red_Dark",
            "size": [ 3.3, 3.3 ],
            "layer": 3
          }
        },
        {
          "direction_text@hud_ds-cvr.direction_text_panel": {
            "ignored": "(not $dimz_cvr_show_direction_label)",
            "layer": 4
          }
        },
        {
          "chunk_border_control": {
            "type": "panel",
            "size": "$chunk_border_step_scale",
            "layer": 2,
            "controls": [
              {
                "chunk_border@hud_ds-cvr.anchored_chunk_border": {
                  "anchor_from": "top_left",
                  "anchor_to": "top_left"
                }
              }
            ]
          }
        }
      ] 
    },
    
    "chunk_viewer_panel": {
      "type": "panel",
      "size": [ 72, 72 ],
      "anchor_from": "$dimz_cvr_anchor_from",
      "anchor_to": "$dimz_cvr_anchor_to",
      "offset": "$dimz_cvr_offset",
      "controls": [
        {
          "background": {
            "type": "image",
            "texture": "textures/ui/chunk_viewer/chunk_background",
            "size": [ 70, 70],
            "anchor_from": "center",
            "anchor_to": "center",
            "layer": 1
          }
        },
        {
          "content": {
            "type": "panel",
            "size": [ "100% - 12px", "100% - 12px" ],
            "anchor_from": "center",
            "anchor_to": "center",
            "layer": 2,
            "controls": [
              {
                "inner_background": {
                  "type": "image",
                  "texture": "textures/ui/chunk_viewer/chunk_inner_background",
                  "layer": 5
                }
              },
              {
                "chunk_viewer@hud_ds-cvr.chunk_viewer": {
                  "layer": 1
                }
              }
            ]
          }
        },
        {
          "chunk_position_panel@hud_ds-cvr.chunk_position_panel": {
            "ignored": "(not $dimz_cvr_show_chunk_info)"
          }
        },
        {
          "chunk_label_panel@hud_ds-cvr.chunk_label_panel": {
            "ignored": "(not $dimz_cvr_show_chunk_info)"
          }
        },
        {
          "map_expand_button@common.root_panel": {
            "ignored": "(not $touch)",
            "size": [ "100%", "100%" ],
            "layer": 12,
            "alpha": 0,
            "propagate_alpha": true,
            "prevent_touch_input": true,
            "controls": [
              {
                "button@hud_ds-cvr.map_expand_button": {}
              }
            ]
          }
        },
        {
          "map_expand_key@hud_ds-cvr.map_expand_button": {
            "$button_mappings": [
              {
                "from_button_id": "button.scoreboard",
                "to_button_id": "button.menu_select",
                "mapping_type": "global"
              }
            ],
            "ignored": "$touch",
            "size": [ "100%", "100%" ],
            "alpha": 0,
            "propagate_alpha": true
          }
        }
      ],
      "bindings": [
        {
          "binding_name": "#player_position_visible",
          "binding_name_override": "#visible",
          "binding_condition": "always"
        }
      ]
    },
    
    
    "player_position": {
      "type": "panel",
      "visible": false,
      "bindings": [
        {
          "binding_type": "view",
          "source_control_name": "player_position_text",
          "source_property_name": "#text",
          "target_property_name": "#player_position_text"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#player_position_text - '-1' - '-2' - '-3' - '-4' - '-5' - '-6' - '-7' - '-8' - '-9')",
          "target_property_name": "#raw_position_text_2"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#raw_position_text_2 - '1' - '2' - '3' - '4' - '5' - '6' - '7' - '8' - '9' - '0')",
          "target_property_name": "#raw_position_text"
        },
        {
          "binding_type": "view",
          "source_property_name": "((#player_position_text - ' ') - (#raw_position_text - ' ' - ':' - ','))",
          "target_property_name": "#raw_position_number"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#raw_position_number - ':')",
          "target_property_name": "#position_x"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#raw_position_number - (':' + #position_x + ','))",
          "target_property_name": "#position_y"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#raw_position_number - (':' + #position_x + ',' + #position_y + ','))",
          "target_property_name": "#position_z"
        },
        {
          "binding_type": "view",
          "source_property_name": "((#position_x - (#position_x < 0) * 15) / 16)",
          "target_property_name": "#chunk_x"
        },
        {
          "binding_type": "view",
          "source_property_name": "((#position_y - (#position_y < 0) * 15) / 16)",
          "target_property_name": "#chunk_y"
        },
        {
          "binding_type": "view",
          "source_property_name": "((#position_z - (#position_z < 0) * 15) / 16)",
          "target_property_name": "#chunk_z"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#position_x - (#chunk_x * 16))",
          "target_property_name": "#in_chunk_x"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#position_y - (#chunk_y * 16))",
          "target_property_name": "#in_chunk_y"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#position_z - (#chunk_z * 16))",
          "target_property_name": "#in_chunk_z"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#chunk_x * -1)",
          "target_property_name": "#reverse_chunk_x"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#chunk_z * -1)",
          "target_property_name": "#reverse_chunk_z"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#in_chunk_x * -1)",
          "target_property_name": "#reverse_in_chunk_x"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#in_chunk_z * -1)",
          "target_property_name": "#reverse_in_chunk_z"
        }
      ]
    }
  }