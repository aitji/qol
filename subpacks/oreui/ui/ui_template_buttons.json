//This is where all the juises are

//a huge chunck of this file is just the button border, it may seem simple but ive spend HOURS on just the borders and its not finished

//there may have too many notes, similar to cornbread's unique packs (check code for reason), but makes it more understandable for others and myself

//huge thanks for @tlgm2308's Ore-ui styled buttons for his pack, Ty-el Ui. His code is not used in this pack (even if i was about to, but didnt) but was quite helpful in learning how the button border works on bedrock edition
{ 
  "button_image": {
  //for some reason, goldenfrog's ore ui pack cause the button corners to be hidden. ill place this here to avoid issues with that pack.
    "$button_image_size": [ "100% - 2px", "100% - 2px" ]
  },
  "focus_border": {
    //setup for border texture
    //some resource packs makes the border behave differently, or its texture is removed, so ill just have the borders be in a different folder
    "$focus_border_texture|default": "textures/border/border_default"
  },

  "new_ui_button_panel": {
    //apparently, you can make a outer border with this panel
    //lets try having 2 images, 1 for the dafault border and another for the selected border
    //both borders will be switched with eachother when the button is in one state, focus border for default, hover pressed for hovered and pressed
    //if the names seems abit familiar to a "certain" ui pack, no it isnt
    //hovered and pressed border is refended as "outline" in this code
    
    //will fix later
    //"$light_border_locked_color|default": [ 0.5, 0.5, 0.5 ],
    "$outline_offset|default": [ 0, 0 ],
    //these are here to avoid content errors
    "$border_color|default": "$light_border_default_color",
    "$border_layer|default": 1,
    //since texture is defined below, keep it to avoid missing textures
    "$border_texture|default": "textures/border/border_default",
    "$outline_texture|default": "textures/border/border_hoverpressed",
    "$outline_visible|default": false,
    "$outline_size|default": [ "100% + 2px", "100% + 2px"],
    "controls": [
      //do NOT remove this to have the button work
      {
        "$button_image@$button_image": {
          "ignored": "(not $button_image_visible)",
          "size": "$button_image_size",
          "offset": "$image_offset",
          "anchor_from": "$image_anchor",
          "anchor_to": "$image_anchor",
          "layer": 1,
          "fill": "$button_image_fill",
          "color": "$button_image_color"
        }
      },
      {
        "button_content": {
          "type": "panel",
          "$button_content_size|default": [ "100% - 6px", "100% - 6px" ],
          "size": "$button_content_size",

          "controls": [
            {
              "$button_type_panel@$button_type_panel": {
                "layer": 3
              }
            }
          ]
        }
      },
      {
        "border@common_buttons.focus_border": {
          "color": "$border_color",
          "layer": "$border_layer",
          "alpha": "$border_alpha",
          "texture": "$border_texture",
          "ignored": "(not $border_visible)"
        }
      },
      {  
        "outline@common_buttons.focus_border": {
          "layer": 2,
          "size": "$outline_size",
          "texture": "$outline_texture",
          "offset": "$outline_offset",
          "ignored": "(not $outline_visible)"
        }
      }
    ]
  },
  "new_ui_form_fitting_button_panel": {
  //for some reason, not all buttons uses the same panel, so i had to setup the border once more but differently
  //the way it works is by having the outline texture be used at all times, and expand when needed to give the illusion of it appearing even thought its always there, just black when deselected
  
    "$outline_texture|default": "textures/border/border_hoverpressed",
    "$button_image_offset|default": [ 0, 0 ], 
    //for some reason, due to the way this panel is setup, the button feels like offsetting itself
    //the variable below is here to force it back to its original position when that happens
    "$focus_border_offset_override|default": [ 0, 1 ],
    //these are placed to avoid content errors, yet they dont work
    "$border_color|default": "$light_border_hover_color",
    "$border_layer|default": 1,
    "controls": [
      //do NOT remove this to have the button work
      {
        "border@common_buttons.focus_border": {
          "color": "$border_color",
          "layer": "$border_layer",
          "size": "$focus_border_size_override",
          "$button_image|default": "common_buttons.button_image",
          "texture": "$outline_texture",
          "offset": "$focus_border_offset_override",
          "controls": [
            {
              "$button_image@$button_image": {
                "size": "$button_image_size_override",
                "offset": "$button_image_offset",
                "$form_fitting_min_size|default": [ 0, 0 ],
                "min_size": "$form_fitting_min_size",
                "layer": 1,
                "controls": [
                  {
                    "button_content": {
                      "type": "panel",
                      "size": "$button_content_size_override",
                      "controls": [
                        {
                          "$button_type_panel@$button_type_panel": {
                            "layer": 3
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  
  /////////////////////////////////
  //
  //  TEXT BUTTON
  //
  /////////////////////////////////

  "light_text_button@light_button_assets": {
    "controls": [
      {
        "default@$button_state_panel": {
          "$new_ui_button_texture": "$default_button_texture",
          "$text_color": "$default_text_color",
          "$secondary_text_color": "$light_button_secondary_default_text_color",
          "$content_alpha": "$default_content_alpha",
          "$border_color": "$light_border_default_color",
          "$border_layer": 2,
          "$default_state": true,
          "$button_alpha": "$default_button_alpha",
          "layer": 1
        }
      },
      {
        "hover@$button_state_panel": {
          "$new_ui_button_texture": "$hover_button_texture",
          "$text_color": "$hover_text_color",
          "$secondary_text_color": "$light_button_secondary_hover_text_color",
          "$content_alpha": 1,
          "$border_color": "$light_border_hover_color",
          "$border_visible": false,
          "$outline_visible": true,
          "$border_layer": 4,
          "$hover_state": true,
          "$button_alpha": "$default_hover_alpha",
          "layer": 4 // This is several layers higher than default in case two buttons share a border and that shared border needs to turn with with either button hover/press state
        }
      },
      {
        "pressed@$button_state_panel": {
          "$new_ui_button_texture": "$pressed_button_texture",
          "$text_color": "$pressed_text_color",
          "$secondary_text_color": "$light_button_secondary_pressed_text_color",
          "$button_offset": "$button_pressed_offset",
          "$content_alpha": "$pressed_alpha",
          "$border_color": "$light_border_pressed_color",
          "$border_visible": false,
          "$outline_visible": true,
          "$outline_size": [ "100% + 2px", "100%" ],
          "$outline_offset": [ 0, 1 ],
          "$border_layer": 5,
          "$pressed_state": true,
          "$button_alpha": "$default_pressed_alpha",
          "layer": 5
        }
      },
      {
        "locked@$button_state_panel": {
          "$new_ui_button_texture": "$locked_button_texture",
          "$text_color": "$locked_text_color",
          "$secondary_text_color": "$light_button_secondary_locked_text_color",
          "$content_alpha": "$locked_alpha",
          "$border_color": "$light_border_locked_color",
          "$button_image": "common_buttons.locked_button_image",
          "$border_layer": 1,
          "$locked_state": true,
          "layer": 1
        }
      }
    ]
  },

  "dark_text_button@dark_button_assets": {
    "controls": [
      {
        "default@$button_state_panel": {
          "$new_ui_button_texture": "$default_button_texture",
          "$text_color": "$dark_button_default_text_color",
          "$secondary_text_color": "$dark_button_secondary_default_text_color",
          "$content_alpha": 1,
          "$border_color": "$dark_border_default_color",
          "$border_layer": 2,
          "$default_state": true,
          "layer": 1
        }
      },
      {
        "hover@$button_state_panel": {
          "$new_ui_button_texture": "$hover_button_texture",
          "$text_color": "$dark_button_hover_text_color",
          "$secondary_text_color": "$dark_button_secondary_hover_text_color",
          "$border_visible": false,
          "$outline_visible": true,
          "$content_alpha": 1,
          "$border_color": "$dark_border_hover_color",
          "$border_layer": 4,
          "$hover_state": true,
          "layer": 4 // This is several layers higher than default in case two buttons share a border and that shared border needs to turn with with either button hover/press state

        }
      },
      {
        "pressed@$button_state_panel": {
          "$new_ui_button_texture": "$pressed_button_texture",
          "$text_color": "$dark_button_pressed_text_color",
          "$secondary_text_color": "$dark_button_secondary_pressed_text_color",
          "$button_offset|default": "$button_pressed_offset",
          "$content_alpha": "$pressed_alpha",
          "$border_color": "$dark_border_pressed_color",
          "$border_visible": false,
          "$outline_visible": true,
          "$outline_size": [ "100% + 2px", "100%" ],
          "$outline_offset": [ 0, 1 ],
          "$border_layer": 5,
          "$pressed_state": true,
          "layer": 5
        }
      },
      {
        "locked@$button_state_panel": {
          "$new_ui_button_texture": "$locked_button_texture",
          "$text_color": "$dark_button_locked_text_color",
          "$secondary_text_color": "$dark_button_secondary_locked_text_color",
          "$content_alpha": "$locked_alpha",
          "$border_color": "$dark_border_locked_color",
          "$button_image": "common_buttons.locked_button_image",
          "$border_layer": 1,
          "$locked_state": true,
          "layer": 1
        }
      }
    ]
  },
  
  /////////////////////////////////
  //
  //  FORM FITTING CONTENT BUTTON
  //
  /////////////////////////////////
  
  //errors seems to also be here, however, ill keep it used this time. Do contact me if you have found a solution
  "light_content_form_fitting_button@common_buttons.light_content_button": {
    "size": [ "100%c", "20px" ],
    "$button_state_panel|default": "common_buttons.new_ui_form_fitting_button_panel",
    "$anchor": "top_left", // Cannot override this or will cause unsolvable layout!
    "$button_offset|default": [ 3, 3 ],
    "$button_pressed_offset|default": [ 3, 4 ],
    "$button_type_panel": "common_buttons.horizontal_form_fitting",
    "$default_state|default": false,
    "$hover_state|default": false,
    "$pressed_state|default": false,
    "$locked_state|default": false,
    "controls": [
      {
        "default@$button_state_panel": {
          "$new_ui_button_texture": "$default_button_texture",
          "$text_color": "$light_button_default_text_color",
          "$border_color": "$light_border_default_color",
          "$focus_border_offset_override": [ 0, 0 ],
          "$content_alpha": "$default_content_alpha",
          "$default_state": true,
          "$button_alpha": "$default_button_alpha",
          "layer": 1
        }
      },
      {
        "hover@$button_state_panel": {
          "$new_ui_button_texture": "$hover_button_texture",
          "$content_alpha": 1,
          "$border_color": "$light_border_hover_color",
          "$text_color": "$light_button_hover_text_color",
          "$focus_border_size_override": [ "100%c + 4px", "100%c + 4px" ],
          "$focus_border_offset_override": [ -1, 0 ],
          "$hover_state": true,
          "$button_alpha": "$default_hover_alpha",
          "layer": 4 // This is several layers higher than default in case two buttons share a border and that shared border needs to turn with with either button hover/press state
        }
      },
      {
        "pressed@$button_state_panel": {
          "$new_ui_button_texture": "$pressed_button_texture",
          "$button_offset": "$button_pressed_offset",
          "$content_alpha": "$pressed_alpha",
          "$text_color": "$light_button_pressed_text_color",
          "$focus_border_size_override": [ "100%c + 4px", "100%c + 2px" ],
          "$focus_border_offset_override": [ -1, 1 ],
          "$button_image_offset": [ 0, -1 ],
          "$outline_size": [ "100% + 2px", "100%" ],
          "$outline_offset": [ 0, 1 ],
          "$pressed_state": true,
          "$button_alpha": "$default_pressed_alpha",
          "layer": 5
        }
      },
      {
        "locked@$button_state_panel": {
          "$new_ui_button_texture": "$locked_button_texture",
          "$text_color": "$light_button_locked_text_color",
          "$border_color": "$light_border_locked_color",
          "$secondary_text_color": "$light_button_secondary_locked_text_color",
          "$content_alpha": "$locked_alpha",
          "$button_image": "common_buttons.locked_button_image",
          "$border_layer": 1,
          "$locked_state": true,
          "layer": 1
        }
      }
    ]
  },

  "dark_content_form_fitting_button@common_buttons.dark_content_button": {
    "controls": [
      {
        "default@$button_state_panel": {
          "$new_ui_button_texture": "$default_button_texture",
