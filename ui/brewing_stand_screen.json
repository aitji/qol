{
	"namespace": "brewing_stand",
	"brewing_panel_top_half": {
		"modifications": [
			{
				"array_name": "controls",
				"operation": "insert_back",
				"value": {"brewing_modifiers_panel@aitji_brewing_guide.brewing_modifiers_panel": {}}
			},
			{
				"array_name": "controls",
				"operation": "insert_back",
				"value": {"brewing_ingredients_panel@aitji_brewing_guide.brewing_ingredients_panel": {}}
			}
		]
	},
	"brewing_stand_screen": {
		"$screen_content": "brewing_stand.brewing_stand_panel",
		"$screen_bg_content": "common.screen_background",
		"$screen_background_alpha": 0.4,
		"modifications": [
			{
				"array_name": "variables",
				"operation": "remove",
				"where": {
					"requires": "$desktop_screen"
				}
			},
			{
				"array_name": "variables",
				"operation": "remove",
				"where": {
					"requires": "$pocket_screen"
				}
			}
		]
	},
	"brewing_stand_panel": {
    "$use_container_item_mode": true,
    "$use_item_highlighter": true,
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "container_item_mode_details_panel@container_item_ds-acr.container_item_mode_details_panel": {
              "layer": 50
            }
          }
        ]
      }
    ]
  },
}