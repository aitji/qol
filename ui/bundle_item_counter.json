{
    "namespace": "ryBIC:item_counter",
    "bundle_item_counter_text": {
        "type": "label",
        "offset": [ 0, 1 ],
        "anchor_to": "bottom_right",
        "anchor_from": "bottom_right",
        "layer": 10,
        "shadow": true,
        "text": "#text",
        "bindings": [
            {
                "binding_name": "#item_storage_visible",
                "binding_name_override": "#visible",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_name": "#item_storage_current_amount",
                "binding_name_override": "#item_storage_current",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_type": "view",
                "source_property_name": "(((#amount_current > #item_storage_current) * -1 + 1) * ((#amount_current < #item_storage_current) * 1 + #amount_current))",
                "target_property_name": "#amount_current",
                "binding_condition": "always_when_visible"
            },
            {
                "binding_type": "view",
                "source_property_name": "('§z' + #amount_current)",
                "target_property_name": "#text"
            }
        ]
    }
}