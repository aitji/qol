{
    "namespace": "item_renderer_ds-beb",
    
    "enchanted_book_renderer": {
      "type": "image",
      "allow_debug_missing_texture": false,
      
      "$renderer_binding_name|default": "#hover_text",
      "$renderer_binding_type|default": "collection",
      "$renderer_binding_collection_name|default": "$item_collection_name",
      "$renderer_binding_condition|default": "always_when_visible",
      
      "$global_binding_type|default": "none",
      "property_bag": {
        "force_update": true,
        "#enchanted_book_name": "$dimz_beb_enchanted_book_name",
        "#tab_item_name": "$dimz_beb_tab_item_name",
        
        "#default_path": "textures/items/enchanted_book/",
        "#ADE": "power",
        "#AFE": "flame",
        "#AIE": "infinity",
        "#AKB": "punch",
        "#CMT": "multishot",
        "#CPG": "piercing",
        "#CQC": "quick_charge",
        "#CBG": "curse_of_binding",
        "#CVG": "curse_of_vanishing",
        "#DAL": "sharpness",
        "#DAS": "bane_of_arthropods",
        "#DUD": "smite",
        "#DGG": "efficiency",
        "#DBY": "unbreaking",
        "#FRE": "fire_aspect",
        "#FSD": "lure",
        "#FWR": "frost_walker",
        "#HWB": "breach",
        "#HWD": "density",
        "#HWW": "wind_burst",
        "#KBK": "knockback",
        "#LBS": "looting",
        "#LBD": "fortune",
        "#LBF": "luck_of_the_sea",
        "#MDG": "mending",
        "#OYN": "respiration",
        "#PAL": "protection",
        "#BAN": "blast_protection",
        "#PFL": "feather_falling",
        "#PFE": "fire_protection",
        "#PPE": "projectile_protection",
        "#SSD": "soul_speed",
        "#SSK": "swift_sneak",
        "#TRS": "thorns",
        "#UHG": "silk_touch",
        "#DSR": "depth_strider",
        "#WWR": "aqua_affinity",
        "#TCG": "channeling",
        "#TLY": "loyalty",
        "#TRE": "riptide",
        "#TIG": "impaling"
      },
      "bindings": [
        {
          "ignored": "($global_binding_type = 'none')",
          "binding_type": "$global_binding_type"
        },
        {
          "binding_name": "$renderer_binding_name",
          "binding_name_override": "#item_name",
          "binding_type": "$renderer_binding_type",
          "binding_collection_name": "$renderer_binding_collection_name",
          "binding_condition": "$renderer_binding_condition"
        },
        {
          "binding_type": "view",
          "source_property_name": "(((#item_name - #enchanted_book_name - #tab_item_name) - '§7' - '§c' - '§') - 'dimzebrf' - 'fr\nreid' - 'fr\n99r\nreid')",
          "target_property_name": "#raw_eb_id",
          "binding_condition": "always_when_visible"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#default_path + 'dimz_' + ('#' + ('%.3s' * #raw_eb_id)))",
          "target_property_name": "#texture",
          "binding_condition": "always_when_visible"
        }
      ]
    }
  }