{
	"item_name_text_root/item_text_aligner/item_text_control/item_text_label": {
    "max_size": [200,11],
    "alpha": 0,
    "clips_children": true,
    "controls": [
      {
        "item_text_label": {
          "type": "label",
          "max_size": [200,"default"],
          "text_alignment": "center",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "color": "$text_color",
          "text": "#text",
          "alpha": "@hud.anim_item_name_text_alpha_in",
          "enable_profanity_filter": false,
          "bindings": [
            {
              "binding_name": "$text_binding",
              "binding_name_override": "#text"
            }
          ]
        }
      }
    ]
  },
  "item_name_text_root/item_text_aligner/item_text_control/item_text_background": { "size": ["100%sm+5px","100%sm+5px"] },
  "custom_hotbar_hud_item_icon": {
    "type": "panel",
    "size": [ 16, 16 ],
    
    "$renderer_binding_name": "#item_text",
    "$renderer_binding_type": "",
    "$renderer_binding_collection_name": "",
    "$renderer_binding_condition": "visible",
    
    "$item_collection_name": "$hotbar_collection_name",
    "controls": [
      {
        "normal_item_renderer": {
          "type": "panel",
          "controls": [
            {
              "item_renderer@common.item_renderer": {
                "layer": 3,
                "property_bag": {
                  "force_update": true
                }
              }
            }
          ]
        }
      }
    ]
  },

	"start_cap_image": {"alpha": 1.0},
	"vignette_renderer": {"ignored": true},

  "hud_screen": {
    "render_only_when_topmost": false,
    "always_accepts_input": false,
    "$screen_animations": [],
    "$background_animations": []
  },
  "gui_hotbar_slot_button_prototype": {"focus_enabled": false},

  // bundle item count in hotbar
  "gui_hotbar_grid_item/hotbar_parent": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": { "item_count_bundle@ryBIC:item_counter.bundle_item_counter_text": { "$item_collection_name": "$hotbar_collection_name" } }
      }
    ]
  }
}