{
	"item_name_text_root/item_text_aligner/item_text_control/item_text_label": {
    "max_size": [200,11],
    "alpha": 0,
    "clips_children": true,
    "controls": [
      {
        "item_text_label": {
          "type": "label",
          "max_size": [200,"default"],
          "text_alignment": "center",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "color": "$text_color",
          "text": "#text",
          "alpha": "@hud.anim_item_name_text_alpha_in",
          "enable_profanity_filter": false,
          "bindings": [
            {
              "binding_name": "$text_binding",
              "binding_name_override": "#text"
            }
          ]
        }
      }
    ]
  },
  "item_name_text_root/item_text_aligner/item_text_control/item_text_background": {
    "size": ["100%sm+5px","100%sm+5px"]
  },
  "custom_hotbar_hud_item_icon": {
    "type": "panel",
    "size": [ 16, 16 ],
    
    "$renderer_binding_name": "#item_text",
    "$renderer_binding_type": "",
    "$renderer_binding_collection_name": "",
    "$renderer_binding_condition": "visible",
    
    "$item_collection_name": "$hotbar_collection_name",
    "controls": [
      {
        "normal_item_renderer": {
          "type": "panel",
          "controls": [
            {
              "item_renderer@common.item_renderer": {
                "layer": 3,
                "property_bag": {
                  "force_update": true
                }
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "$renderer_binding_name",
              "binding_name_override": "#item_name"
            },
            {
              "binding_name": "#item_id_aux",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_name": "#slot_selected",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#item_name - '§d§i§m§z§e§b§r§f') = #item_name) = 0)",
              "target_property_name": "#is_enchanted_book"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#item_name - '§e§i§d') = #item_name) = 0)",
              "target_property_name": "#has_properties"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#item_id_aux = -1))",
              "target_property_name": "#not_empty_slot"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#is_enchanted_book * #has_properties * #slot_selected * #not_empty_slot) = 0)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "enchanted_book_renderer": {
          "type": "panel",
          "controls": [
            {
              "item_renderer@item_renderer_ds-beb.enchanted_book_renderer": {
                "layer": 3
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "normal_item_renderer",
              "source_property_name": "(not #visible)",
              "target_property_name": "#visible",
              "resolve_sibling_scope": true
            }
          ]
        }
      }
    ]
  },
  
  "gui_hotbar_grid_item_pocket/hotbar_parent": {
    "modifications": [
      {
        "control_name": "item_icon",
        "operation": "replace",
        "value": {
          "item_icon@hud.custom_hotbar_hud_item_icon": {}
        }
      }
    ]
  },
  
  "gui_hotbar_grid_item/hotbar_parent": {
    "modifications": [
      {
        "control_name": "item_icon",
        "operation": "replace",
        "value": {
          "item_icon@hud.custom_hotbar_hud_item_icon": {}
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "suspicious_stew_effect_icon@effect_icon_ds-ssi.suspicious_stew_effect_icon": {
            "$item_collection_name": "$hotbar_collection_name",
            "size": [ 9, 9 ],
            "anchor_from": "top_right",
            "anchor_to": "top_right",
            "offset": [ -1, 1 ],
            "layer": 4
          }
        }
      }
    ]
  },
	"start_cap_image": {"alpha": 1.0},
	"vignette_renderer": {"ignored": true},

  "hud_screen": {
    "render_only_when_topmost": false,
    "always_accepts_input": true,
    "$screen_animations": [],
    "$background_animations": []
  },
  "gui_hotbar_slot_button_prototype": {
    "focus_enabled": false
  }
}