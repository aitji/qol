  "container_item_mode_details_alpha": {
    "anim_type": "alpha",
    "easing": "in_quint",
    "duration": "$duration",
    "$duration|default": 2,
    "from": 1.0,
    "to": 0
  },
  
  "container_item_mode_details_label": {
    "type": "label",
    "layer": 1,
    "color": "$item_hover_text_color",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$switch_details_name",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
  
  "container_item_mode_details": {
    "type": "image",
    "texture": "textures/ui/purpleBorder",
    "size": ["100%c+8px","100%c+8px"],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [0,16],
    "layer": 5,
    "alpha": "@container_item_ds-acr.container_item_mode_details_alpha",
    "propagate_alpha": true,
    "controls": [
      {
        "default@container_item_ds-acr.container_item_mode_details_label": {
          "$switch_details_name": "default_mode_toggle",
          "text": "containerA.switcherHoverText.default"
        }
      },
      {
        "autoplace@container_item_ds-acr.container_item_mode_details_label": {
          "$switch_details_name": "autoplace_mode_toggle",
          "text": "containerA.switcherHoverText.autoplace"
        }
      },
      {
        "drop@container_item_ds-acr.container_item_mode_details_label": {
          "$switch_details_name": "drop_mode_toggle",
          "text": "containerA.switcherHoverText.drop"
        }
      }
    ]
  },
  
  "container_item_mode_details_panel": {
    "type": "collection_panel",
    "factory": {
      "name": "container_item_mode_details_factory",
      "control_name": "container_item_ds-acr.container_item_mode_details",
      "max_children_size": 1
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "default_mode_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#default_mode"
      },
      {
        "binding_type": "view",
        "source_control_name": "autoplace_mode_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#autoplace_mode"
      },
      {
        "binding_type": "view",
        "source_control_name": "drop_mode_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#drop_mode"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#default_mode + #autoplace_mode + #drop_mode * 1)",
        "target_property_name": "#collection_length"
      },
      {
        "binding_name": "#using_touch",
        "binding_name_override": "#visible"
      }
    ]
  },
  
  
  "custom_hover_text_control": {
    "ignored": "($toggle_unchecked or $default_state)",
    
    "type": "image",
    "texture": "textures/ui/purpleBorder",
    "size": ["100%c+8px","100%c+8px"],
    "anchor_from": "$hover_text_anchor_from",
    "anchor_to": "$hover_text_anchor_to",
    "offset": "$hover_text_offset",
    "layer": 32,
    
    "controls": "$hover_text_controls",
    "$hover_text_controls|default": [
      {
        "text": {
          "type": "label",
          "text": "$hover_text",
          "layer": 1,
          "color": "$item_hover_text_color"
        }
      }
    ]
  },
  
  "custom_hover_text": {
    "type": "button",
    "layer": 32,
    "$default_state|default": false,
    "$toggle_unchecked|default": false,
    
    "locked_control": "locked",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    
    "follows_cursor": "(not $touch)",
    "always_handle_pointer": "(not $touch)",
    "focus_enabled": false,
    "consume_event": false,
    "consume_hover_events": false,
    
    "$hover_text_anchor_from|default": "bottom_right",
    "$hover_text_anchor_to|default": "top_left",
    "$hover_text_offset|default": [0,0],
    "controls": [
      { "default@container_item_ds-acr.custom_hover_text_control": {} },
      { "pressed@container_item_ds-acr.custom_hover_text_control": {} },
      { "hover@container_item_ds-acr.custom_hover_text_control": {} },
      { "locked@common.empty_panel": {} }
    ]
  },
  
  
  "toggle_switcher_icon": {
    "type": "image",
    "size": [10,10],
    "layer": 5,
    "color": "$color",
    "$color|default": "$light_glyph_hover_color",
    "variables": [
      {
        "requires": "$toggle_unchecked",
        "$color": "$light_glyph_default_color"
      }
    ],
    "controls": [
      {
        "hover_text@container_item_ds-acr.custom_hover_text": {
          "bindings": [
            {
              "binding_name": "(not #using_touch)",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },
  
  "drop_mode_toggle_switcher_icon@container_item_ds-acr.toggle_switcher_icon": {
    "$hover_text": "containerA.switcherHoverText.autoplace",
