{
  "namespace": "container_item_ds-acr",
  
  
  "crafting_item_reset_button_icon": {
    "type": "image",
    "size": [13,13],
    "texture": "textures/ui/clear_craft_glyph"
  },
  
  "crafting_item_reset_button": {
    "type": "button",
    "focus_enabled": false,
    "consume_event": false,
    "consume_hover_events": false,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      }
    ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$collection_name"
      }
    ]
  },
  
  "crafting_item_reset_button_panel": {
    "type": "panel",
    "size": [18,18],
    "$crafting_slot_amount|default": 4,
    "controls": [
      {
        "crafting_item_reset_button@common_buttons.light_content_button": {
          "$default_state_border_visible": false,
          "$hover_state_border_visible": false,
          "$pressed_state_border_visible": false,
          "$locked_state_border_visible": false,
          "$pressed_button_name": "button.clear_crafting_items",
          "$button_content": "container_item_ds-acr.crafting_item_reset_button_icon",
          "layer": 1
        }
      },
      {
        "crafting_item_reset_btn": {
          "type": "collection_panel",
          "layer": 5,
          "collection_name": "crafting_input_items",
          "$collection_name": "crafting_input_items",
          "property_bag": {
            "#slot_amount": "$crafting_slot_amount"
          },
          "factory": {
            "name": "crafting_item_reset_button_factory",
            "control_name": "container_item_ds-acr.crafting_item_reset_button"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "#slot_amount",
              "target_property_name": "#collection_length"
            }
          ]
        }
      }
    ]
  },
  
  
