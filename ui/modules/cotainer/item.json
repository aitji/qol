    "$toggle_view_binding_name": "selected_item_highlight_enabled",
    "$button_content": "container_item_ds-acr.selected_item_highlighter_toggle_icon",
    
    "ignored": "(not $use_item_highlighter)",
    "size": "$advanced_button_size",
    
    "$use_search_bar|default": false,
    "bindings": [
      {
        "ignored": "(not $use_search_bar)",
        "binding_type": "view",
