{
    "namespace": "effect_icon_ds-ssi",
    
    "suspicious_stew_effect_icon": {
      "type": "image",
      "allow_debug_missing_texture": false,
      "property_bag": {
        "#suspicious_stew_0": "night_vision_effect",
        "#suspicious_stew_1": "jump_boost_effect",
        "#suspicious_stew_2": "weakness_effect",
        "#suspicious_stew_3": "blindness_effect",
        "#suspicious_stew_4": "poison_effect",
        "#suspicious_stew_6": "hunger_full",
        "#suspicious_stew_7": "fire_resistance_effect",
        "#suspicious_stew_8": "regeneration_effect",
        "#suspicious_stew_9": "wither_effect"
      },
      "bindings": [
        {
          "binding_type": "collection_details"
        },
        {
          "binding_name": "#item_id_aux",
          "binding_type": "collection",
          "binding_collection_name": "$item_collection_name"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#item_id_aux / 65536)",
          "target_property_name": "#item_id"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#item_id_aux - (#item_id * 65536))",
          "target_property_name": "#child_item_id",
          "binding_condition": "always_when_visible"
        },
        {
          "binding_type": "view",
          "source_property_name": "('textures/ui/' + ('#suspicious_stew_' + #child_item_id))",
          "target_property_name": "#texture",
          "binding_condition": "always_when_visible"
        },
        {
          "binding_type": "view",
          "source_property_name": "(#item_id = $suspicious_stew_id)",
          "target_property_name": "#visible"
        }
      ]
    }
}