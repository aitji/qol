{
	"namespace": "perf_turtle",
	"perf_turtle_panel": {
		"type": "panel",
		"anchor_from": "left_middle",
		"anchor_to": "left_middle",
		"size": [ "100%", "100%c" ],
		"max_size": [ "100%", "50%" ],
		"bindings": [
			{
				"binding_type": "view",
				"source_control_name": "purtle",
				"source_property_name": "#toggle_state",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"perf_turtle_background": {
					"type": "image",
					"texture": "textures/ui/Black",
					"alpha": 0.5,
					"size": [ "100%", 35 ]
				}
			},
			{
				"stack_panel": {
					"type": "stack_panel",
					"anchor_from": "bottom_left",
					"anchor_to": "bottom_left",
					"size": [ "100%", 70 ],
					"orientation": "horizontal",
					"controls": [
						{
							"turtle": {
								"size": [ 35, 35 ],
								"type": "image",
								"texture": "textures/ui/purtle"
							}
						},
						{
							"turtle_text": {
								"type": "label",
								"size": [ "fill", "default" ],
								"text": "Hello! My name is Purtle",
								"font_type": "smooth",
								"color": "$main_header_text_color"
							}
						}
					]
				}
			}
		]
	}
}