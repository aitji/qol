{
    "namespace": "stonecutter",
    "crafting_arrow_icon": {
    "type": "image",
    "texture": "textures/ui/arrow_large",
    "size": [18,12],
    "controls": [
        {
          "hover_text@container_item_ds-acr.custom_hover_text": {
            "$hover_text": "containerA.quickCraftButton",
            "$hover_text_anchor_from": "bottom_middle",
            "$hover_text_anchor_to": "top_middle",
            "$hover_text_offset": [0,5]
          }
        }
      ]
    },
    
    "quick_craft_button@common_buttons.light_content_button": {
      "$default_state_border_visible": false,
      "$hover_state_border_visible": false,
      "$pressed_state_border_visible": false,
      "$locked_state_border_visible": false,
      "$button_content": "stonecutter.crafting_arrow_icon",
      "size": [22,16],
      "layer": 3,
      "property_bag": {
        "#collection_name": "stonecutter_result_items"
      },
      "button_mappings": [
        {
          "from_button_id": "button.menu_select",
          "to_button_id": "button.container_auto_place",
          "mapping_type": "double_pressed"
        },
        {
          "from_button_id": "button.menu_ok",
          "to_button_id": "button.container_auto_place",
          "mapping_type": "double_pressed"
        }
      ]
    },
    
    
    "top_half_stack_panel/arrow_holder/arrow_icon": {
      "alpha": 0,
      "controls": [
        {
          "quick_craft_button@stonecutter.quick_craft_button": {}
        }
      ],
      "bindings": [
        {
          "binding_name": "#has_input_item",
          "binding_name_override": "#enabled"
        }
      ]
    },
    
    "stonecutter_panel": {
      "$use_container_item_mode": true,
      "$use_item_highlighter": true,
      "modifications": [
        {
          "array_name": "controls",
          "operation": "insert_front",
          "value": [
            {
              "container_item_mode_details_panel@container_item_ds-acr.container_item_mode_details_panel": {
                "layer": 50
              }
            }
          ]
        }
      ]
    },
    
    "stone_book_panel": {
      "modifications": [
        {
          "array_name": "controls",
          "operation": "insert_front",
          "value": {
            "tooltip_button@container_item_ds-acr.tooltip_button_panel": {
              "anchor_from": "top_left",
              "anchor_to": "top_right"
            }
          }
        }
      ]
    },
    
    "right_panel": {
      "modifications": [
        {
          "array_name": "controls",
          "operation": "insert_front",
          "value": [
            {
              "container_item_data@container_item_data_ds-acr.total_data": {}
            },
            {
              "container_control_panel@container_item_ds-acr.container_control_panel": {
                "anchor_from": "top_right",
                "anchor_to": "top_left"
              }
            }
          ]
        }
      ]
    },
    "top_half_panel": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_front",
                "value": [
                    {
                        "stonecutter_input_slot": {
                            "size": [0,0],
                            "type": "panel",
                            "bindings": [
                                {
                                    "binding_name": "#item_id_aux",
                                    "binding_type": "collection",
                                    "binding_collection_name": "stonecutter_input_items"
                                },
                                {
                                    "binding_name": "#inventory_stack_count",
                                    "binding_type": "collection",
                                    "binding_collection_name": "stonecutter_input_items"
                                }
                            ]
                        }
                    },
                    {
                        "stonecutter_output_slot": {
                            "size": [0,0],
                            "type": "panel",
                            "bindings": [
                                {
                                    "binding_name": "#item_id_aux",
                                    "binding_type": "collection",
                                    "binding_collection_name": "stonecutter_result_items"
                                },
                                {
                                    "binding_name": "#inventory_stack_count",
                                    "binding_type": "collection",
                                    "binding_collection_name": "stonecutter_result_items"
                                }
                            ]
                        }
                    },
                    {
                        "total_item_can_be_crafting": {
                            "type": "label",
                            "text": "#text",
                            "color": "$title_text_color",
                            "anchor_from": "right_middle",
                            "anchor_to": "right_middle",
                            "offset": [-35,18],
                            "bindings": [
                                {
                                    "binding_type": "view",
                                    "source_control_name": "stonecutter_input_slot",
                                    "source_property_name": "( (not (#inventory_stack_count * 1 > 1) * (not (#item_id_aux = -1) + 0)) + #inventory_stack_count * 1 )",
                                    "target_property_name": "#input"
                                },
                                {
                                    "binding_type": "view",
                                    "source_control_name": "stonecutter_output_slot",
                                    "source_property_name": "( (not (#inventory_stack_count * 1 > 1) * (not (#item_id_aux = -1) + 0)) + #inventory_stack_count * 1 )",
                                    "target_property_name": "#output"
                                },
                                {
                                    "binding_type": "view",
                                    "source_property_name": "(not (#input * #output) = 0)",
                                    "target_property_name": "#visible"
                                },
                                {
                                    "binding_type": "view",
                                    "source_property_name": "('x' + #input * #output)",
                                    "target_property_name": "#text"
                                }
                            ]
                        }
                    }
                ]
            }
        ]
    },
    "arrow_icon": {
        "controls": [
            {
                "stonecutter_quick_craft_button@aitji_quick_crafting.stonecutter_quick_craft_button": {
                    "size": [26,26],
                    "offset": [4,7]
                }
            }
        ]
    }
}