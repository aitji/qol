{
    "namespace": "trade2",
    "top_half_stack_panel/how_to_play_button_holder": {
        "modifications": [
            {
                "control_name": "how_to_play_button",
                "operation": "remove"
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "quick_trade_button@aitji_quick_crafting.quick_trade_button": {
                            "anchor_from": "right_middle",
                            "anchor_to": "right_middle"
                        }
                    }
                ]
            }
        ]
    },
    "hover_button": {
        "modifications": [
            {
                "array_name": "bindings",
                "operation": "remove",
                "where": {
                    "binding_name": "(not #using_touch)"
                }
            }
        ]
    },
    "trade_icons@trade2.toggle_content": {
        "layer": 11,
        "offset": [
            0,
            4
        ],
        "$template_toggle": "trade2.toggle_content"
    },
    "trade_toggle_holder": {
        "size": [
            "100%",
            "60%c - 1px"
        ],
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "trade_icons_holder@trade2.trade_icons": {
                            "anchor_from": "top_middle",
                            "anchor_to": "top_middle"
                        }
                    }
                ]
            }
        ]
    },
    "tier_stack_panel": {
        "modifications": [
            {
                "array_name": "bindings",
                "operation": "remove",
                "where": {
                    "binding_name": "#tier_visible"
                }
            }
        ]
    },
    "sell_item": {
    "$use_enchanted_book_renderer": true
  },
  
  "single_item_grid/item_with_count": {
    "$renderer_binding_name": "#hover_text",
    "$renderer_binding_type": "",
    "$renderer_binding_collection_name": "sell_item",
    "$renderer_binding_condition": "visible",
    "$global_binding_type": "collection_details",
    
    "$use_enchanted_book_renderer|default": false,
    "controls": [
      {
        "normal_item_renderer": {
          "ignored": "(not $use_enchanted_book_renderer)",
          "type": "panel",
          "size": [ 16, 16 ],
          "controls": [
            {
              "item_renderer@common.item_renderer": {
                "size": [ 16, 16 ],
                "layer": 1,
                "bindings": [
                  {
                    "binding_type": "collection_details"
                  },
                  {
                    "binding_name": "#item_id_aux"
                  },
                  {
                    "binding_name": "#item_custom_color"
                  },
                  {
                    "binding_name": "#item_pickup_time"
                  },
                  {
                    "binding_name": "#banner_patterns"
                  },
                  {
                    "binding_name": "#banner_colors"
                  },
                  {
                    "binding_name": "#banner_type"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details"
            },
            {
              "binding_name": "$renderer_binding_name",
              "binding_name_override": "#item_name",
              "binding_type": "$renderer_binding_type",
              "binding_collection_name": "$renderer_binding_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#item_name - '§d§i§m§z§e§b§r§f') = #item_name) = 0)",
              "target_property_name": "#is_enchanted_book"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#item_name - '§e§i§d') = #item_name) = 0)",
              "target_property_name": "#has_properties"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#is_enchanted_book * #has_properties) = 0)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "enchanted_book_renderer": {
          "ignored": "(not $use_enchanted_book_renderer)",
          "type": "panel",
          "size": [ 16, 16 ],
          "$item_collection_name": "sell_item",
          "controls": [
            {
              "item_renderer@item_renderer_ds-beb.enchanted_book_renderer": {
                "size": [ 16, 16 ],
                "layer": 1
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "normal_item_renderer",
              "source_property_name": "(not #visible)",
              "target_property_name": "#visible",
              "resolve_sibling_scope": true
            }
          ]
        }
      },
      {
        "renderer_controls": {
          "ignored": "(not $use_enchanted_book_renderer)",
          "type": "panel",
          "size": [ 16, 16 ],
          "controls": [
            {
              "stack_count_label@trade2.stack_count_label": {
                "layer": 2,
                "text": "#trade_item_count",
                "anchor_from": "bottom_right",
                "anchor_to": "bottom_right",
                "offset": [ 1, 1 ],
                "bindings": [
                  {
                    "binding_type": "collection_details"
                  },
                  {
                    "binding_name": "#trade_item_count"
                  },
                  {
                    "binding_name": "(not #trade_price_different)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "changed_item_count_label@trade2.changed_item_count_label": {
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "offset": [ 4, 1 ],
                "bindings": [
                  {
                    "binding_type": "collection_details"
                  },
                  {
                    "binding_name": "#trade_item_count"
                  },
                  {
                    "binding_name": "#trade_price_different",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "hover_button@trade2.hover_button": {}
            }
          ]
        }
      },
      {
        "item_renderer@common.item_renderer": {
          "ignored": "$use_enchanted_book_renderer",
          "size": "$item_renderer_size",
          "$item_renderer_size|default": [ 16, 16 ],
          "layer": 1,
          "bindings": [
            {
              "binding_type": "collection_details"
            },
            {
              "binding_name": "#item_id_aux"
            },
            {
              "binding_name": "#item_custom_color"
            },
            {
              "binding_name": "#item_pickup_time"
            },
            {
              "binding_name": "#banner_patterns"
            },
            {
              "binding_name": "#banner_colors"
            },
            {
              "binding_name": "#banner_type"
            }
          ],
          "controls": [
            {
              "stack_count_label@trade2.stack_count_label": {
                "layer": 2,
                "text": "#trade_item_count",
                "anchor_from": "bottom_right",
                "anchor_to": "bottom_right",
                "offset": [ 1, 1 ],
                "bindings": [
                  {
                    "binding_type": "collection_details"
                  },
                  {
                    "binding_name": "#trade_item_count"
                  },
                  {
                    "binding_name": "(not #trade_price_different)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "changed_item_count_label@trade2.changed_item_count_label": {
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "offset": [ 4, 1 ],
                "bindings": [
                  {
                    "binding_type": "collection_details"
                  },
                  {
                    "binding_name": "#trade_item_count"
                  },
                  {
                    "binding_name": "#trade_price_different",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "hover_button@trade2.hover_button": {}
            }
          ]
        }
      }
    ]
  },
  "quick_trade_button_icon": {
    "type": "image",
    "texture": "textures/items/emerald",
    "size": [18,18],
    "controls": [
      {
        "hover_text@container_item_ds-acr.custom_hover_text": {
          "$hover_text": "containerA.quickTradeButton",
          "$hover_text_anchor_from": "top_middle",
          "$hover_text_anchor_to": "bottom_right",
          "$hover_text_offset": [0,5]
        }
      }
    ]
  },
  
  "quick_trade_button@common_buttons.light_content_button": {
    "$button_content": "trade2_pocket.quick_trade_button_icon",
    "property_bag": {
      "#collection_name": "trade2_result_item"
    },
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "double_pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "double_pressed"
      }
    ]
  },
  
  "trade_and_help_buttons/how_to_play_button_holder": {
    "controls": [
      {
        "quick_trade_button@trade2_pocket.quick_trade_button": {
          "size": [32,"100%"],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "bindings": [
            {
              "binding_name": "#trade_button_enabled",
              "binding_name_override": "#enabled"
            }
          ]
        }
      }
    ]
  }
}